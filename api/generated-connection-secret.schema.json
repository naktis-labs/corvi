        "TLS_CA_PEM": {
          "type": "string",
          "minLength": 1
        },
        "MCP_URL": {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^https://"
        },
        "API_TOKEN": {
          "type": "string",
          "minLength": 1,
          "description": "Independent provider app bearer token; not provider admin or upstream OAuth refresh/access."
        }
      },
      "required": [
        "CONNECTION_SHAPE",
        "CONNECTION_MODE",
        "AUTH_TYPE",
        "CREDENTIAL_GRANULARITY",
        "PROVIDER_NAME",
        "CREDENTIAL_REVISION",
        "MCP_URL",
        "API_TOKEN"
      ],
      "description": "Decoded flat Secret.data keys for providerDirect mcp; never a JSON credential file.",
      "oneOf": [
        {
          "properties": {
            "CREDENTIAL_GRANULARITY": {
              "const": "providerIdentity"
            }
          },
          "required": [
            "IDENTITY_NAME"
          ],
          "not": {
            "required": [
              "MAILBOX_NAME"
            ]
          }
        },
        {
          "properties": {
            "CREDENTIAL_GRANULARITY": {
              "const": "providerMailbox"
            }
          },
          "required": [
            "MAILBOX_NAME"
          ],
          "not": {
            "required": [
              "IDENTITY_NAME"
            ]
          }
        }

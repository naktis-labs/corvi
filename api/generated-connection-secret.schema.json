          ]
        },
        "SMTP_USERNAME": {
          "type": "string",
          "minLength": 1
        },
        "SMTP_PASSWORD": {
          "type": "string",
          "minLength": 1
        },
        "SMTP_FROM_ADDRESS": {
          "type": "string",
          "minLength": 1,
          "format": "email"
        },
        "SMTP_ENVELOPE_FROM": {
          "type": "string",
          "minLength": 1,
          "format": "email"
        }
      },
      "required": [
        "CONNECTION_SHAPE",
        "CONNECTION_MODE",
        "AUTH_TYPE",
        "CREDENTIAL_GRANULARITY",
        "PROVIDER_NAME",
        "CREDENTIAL_REVISION",
        "IDENTITY_NAME",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_TLS_MODE",
        "SMTP_SERVER_NAME",
        "SMTP_AUTH_MECHANISM",
        "SMTP_USERNAME",
        "SMTP_PASSWORD",
        "SMTP_FROM_ADDRESS"

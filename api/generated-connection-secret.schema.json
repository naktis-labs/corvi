  "x-corvi-contract": {
    "resourceKinds": [
      "MailCredential"
    ],
    "outputSecretType": "Opaque",
    "customMetadata": "secretTemplate.metadata.name and .annotations only, same namespace, controlled Secret ownership.",
    "mandatory": "Flat individual Secret.data scalar text keys. Exactly one explicitly declared shape, no unused protocol keys.",
    "forbiddenSecretKeys": [
      "credentials.json",
      "connection.json",
      "CREDENTIALS_JSON",
      "CONNECTION_JSON"
    ],
    "gatewaylessScopedRejection": "For a provider with no gatewayRef, presence of spec.permissions MUST be denied by webhook and issuer (GatewayRequiredForScopedCredential), and no scoped token or Secret published.",
    "providerDirectRestriction": "Unbound provider: permissions absent; targetRef.kind MailIdentity requires native providerIdentity issuance, Mailbox requires native providerMailbox issuance. Bound provider: require MailIdentity + nonempty permissions, no mailbox targets or direct-provider fallback.",
    "providerCapabilities": "Provider plugin must advertise verified appCredentials.shapes and appCredentials.granularities; cannot reuse provider admin credentials, upstream OAuth refresh/access or broaden identity scope.",
    "routing": "One bound gateway can have replicas, but provider app credentials cannot bypass bound gateway; changes require revocation and new issuance.",
    "schemaNotes": "The root oneOf validates a MailCredential spec fragment OR decoded flat Secret.data fixture, not an implemented structural CRD. Cross-resource checks require the webhook.",
    "security": "Separate namespaced Secret publisher with admission and secure handoff; gateway/plugin Pods have no Kubernetes API token.",
    "appliesTo": "Single MailCredential with gateway-bound Corvi-scoped or unbound provider-native issuance derived from parent references and validated by webhook + reconciler.",
    "admission": {
      "kind": "ValidatingAdmissionWebhook",
      "resources": [
        "mailcredentials"
      ],
      "operations": [
        "CREATE",
        "UPDATE"
      ],
      "failurePolicy": "Fail",
      "sideEffects": "None",
      "checks": "same-namespace parent chain, provider native shape and granularity, permissions mode, gateway availability, safe secretTemplate metadata",
      "recheck": "Issuer and operator revalidate on parent/route/capability changes after CREATE/UPDATE; admission is not ongoing authorization.",
      "privileges": "Read-only named MailIdentity/Mailbox/MailProvider/CorviGateway/capability status; NO Secret writes or token issuance."
    }
  }
}

  "x-corvi-contract": {
    "resourceKinds": [
      "MailCredential",
      "ProviderAppCredential"
    ],
    "outputSecretType": "Opaque",
    "customMetadata": "secretTemplate.metadata.name and .annotations only, same namespace, controlled Secret ownership.",
    "mandatory": "Flat individual Secret.data scalar text keys. Exactly one explicitly declared shape, no unused protocol keys.",
    "forbiddenSecretKeys": [
      "credentials.json",
      "connection.json",
      "CREDENTIALS_JSON",
      "CONNECTION_JSON"
    ],
    "gatewaylessScopedRejection": "MailCredential fails GatewayRequiredForScopedCredential if its MailIdentity resolves through a provider without gatewayRef; produce no Secret.",
    "providerDirectRestriction": "ProviderAppCredential only if gatewayRef absent. A bound/suspended provider never permits direct fallback. MailIdentity target requires providerIdentity; Mailbox target requires providerMailbox.",
    "providerCapabilities": "Provider plugin must advertise verified appCredentials.shapes and appCredentials.granularities; cannot reuse provider admin credentials, upstream OAuth refresh/access or broaden identity scope.",
    "routing": "One bound gateway can have replicas, but provider app credentials cannot bypass bound gateway; changes require revocation and new issuance.",
    "schemaNotes": "Examples are decoded key/value fixtures, not actual JSON blobs inside Secrets. API/CRDs not yet implemented.",
    "security": "Separate namespaced Secret publisher with admission and secure handoff; gateway/plugin Pods have no Kubernetes API token."
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corvi.naktis.eu/schemas/generated-connection-secret/v1alpha1",
  "title": "Corvi app-credential producer and flat Secret.data contract (proposed)",
  "description": "One explicit mcp/rest/smtp shape per Secret. Scoped MailCredential MUST have bound gateway; gatewayless only provider-native ProviderAppCredential. No credentials.json, connection.json, embedded JSON or generic credential document. Design only, no implemented CRD/controller.",
  "oneOf": [
    {
      "$ref": "#/$defs/mailCredentialSpec"
    },
    {
      "$ref": "#/$defs/providerAppCredentialSpec"
    },
    {
      "$ref": "#/$defs/secretData"
    }
  ],
  "$defs": {
    "secretTemplate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "annotations": {
              "type": "object",
              "propertyNames": {
                "maxLength": 253
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 4096
              },
              "maxProperties": 32
            }
          }
        }
      },
      "required": [
        "metadata"
      ]
    },
    "mailCredentialSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "mcp",
            "rest",
            "smtp"
          ]
        },
        "identityRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            }
          },
          "required": [
            "name"
          ]
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "mail:identities:list",
              "mail:messages:list",
              "mail:messages:search",
              "mail:messages:read",
              "mail:attachments:read",
              "mail:messages:send",
              "mail:submissions:read",
              "mail:messages:subscribe"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 16
        },
        "secretTemplate": {
          "$ref": "#/$defs/secretTemplate"
        }
      },
      "required": [
        "shape",
        "identityRef",
        "permissions"
      ],
      "description": "Corvi-scoped MailCredential. Explicitly reject GatewayRequiredForScopedCredential when resolved provider has no gatewayRef."
    },
    "providerAppCredentialSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "mcp",
            "rest",
            "smtp"
          ]
        },
        "targetRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "MailIdentity",
                "Mailbox"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        "secretTemplate": {
          "$ref": "#/$defs/secretTemplate"
        }
      },
      "required": [
        "shape",
        "targetRef"
      ],
      "description": "Provider-native app token only for unbound provider. Provider decides true identity or mailbox issuance granularity. No Corvi-grant fields allowed."
    },
    "gatewayMCPSecretData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "CONNECTION_SHAPE": {
          "const": "mcp"
        },
        "CONNECTION_MODE": {
          "const": "gateway"
        },
        "AUTH_TYPE": {
          "const": "oauth2_client_credentials"
        },
        "CREDENTIAL_GRANULARITY": {
          "type": "string",
          "enum": [
            "corviIdentity"
          ]
        },
        "PROVIDER_NAME": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "CREDENTIAL_REVISION": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "IDENTITY_NAME": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "TLS_CA_PEM": {
          "type": "string",
          "minLength": 1
        },
        "MCP_URL": {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^https://"
        },
        "OAUTH_TOKEN_URL": {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^https://"
        },
        "OAUTH_CLIENT_ID": {
          "type": "string",
          "minLength": 1
        },
        "OAUTH_CLIENT_SECRET": {
          "type": "string",
          "minLength": 1
        },
        "OAUTH_RESOURCE": {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^https://"
        },
        "OAUTH_SCOPES": {
          "type": "string",
          "minLength": 1,
          "description": "Space-delimited OAuth action scopes; not a JSON array."
        }
      },
      "required": [
        "CONNECTION_SHAPE",
        "CONNECTION_MODE",
        "AUTH_TYPE",
        "CREDENTIAL_GRANULARITY",
        "PROVIDER_NAME",
        "CREDENTIAL_REVISION",
        "IDENTITY_NAME",
        "MCP_URL",
        "OAUTH_TOKEN_URL",
        "OAUTH_CLIENT_ID",
        "OAUTH_CLIENT_SECRET",
        "OAUTH_RESOURCE",
        "OAUTH_SCOPES"
      ],
      "description": "Decoded flat Secret.data keys for gateway mcp; never a JSON credential file."
    },
    "gatewayRESTSecretData": {
      "type": "object",

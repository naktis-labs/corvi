{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corvi.naktis.eu/schemas/generated-connection-secret/v1alpha1",
  "title": "One MailCredential CRD with validating webhook and flat-key Secret publishing",
  "description": "Single MailCredential resource for gateway-scoped and provider-native app credentials. Webhook checks requested permissions/targetRef against MailProvider.gatewayRef and provider capabilities. Reconciler rechecks on parent changes. Only flat Secret.data keys, one mcp/rest/smtp shape, no JSON credential bundles. Design only, not implemented.",
  "oneOf": [
    {
      "$ref": "#/$defs/mailCredentialSpec"
    },
    {
      "$ref": "#/$defs/secretData"
    }
  ],
  "$defs": {
    "secretTemplate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "annotations": {
              "type": "object",
              "propertyNames": {
                "maxLength": 253
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 4096
              },
              "maxProperties": 32
            }
          }
        }
      },
      "required": [
        "metadata"
      ]
    },
    "mailCredentialSpec": {
      "type": "object",
      "additionalProperties": false,
      "description": "Only credential CRD. Webhook resolves targetRef and MailProvider.gatewayRef; bound provider requires MailIdentity + nonempty permissions, unbound provider forbids permissions entirely and checks native target granularity/shape. Reconciler revalidates when parents change.",
      "properties": {
        "shape": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "mcp",
            "rest",
            "smtp"
          ]
        },
        "targetRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "MailIdentity",
                "Mailbox"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "mail:identities:list",
              "mail:messages:list",
              "mail:messages:search",
              "mail:messages:read",
              "mail:attachments:read",
              "mail:messages:send",
              "mail:submissions:read",
              "mail:messages:subscribe"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 16,
          "description": "Optional syntactically; if present MUST target MailIdentity under an active gateway. Presence at gatewayless provider is rejected with GatewayRequiredForScopedCredential; native direct credential MUST OMIT it, even [] is forbidden."
        },
        "secretTemplate": {
          "$ref": "#/$defs/secretTemplate"
        }
      },
      "required": [
        "shape",
        "targetRef"
      ]
    },
    "gatewayMCPSecretData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "CONNECTION_SHAPE": {
          "const": "mcp"
        },
        "CONNECTION_MODE": {
          "const": "gateway"
        },
        "AUTH_TYPE": {
          "const": "oauth2_client_credentials"
        },
        "CREDENTIAL_GRANULARITY": {
          "type": "string",
          "enum": [
            "corviIdentity"
          ]
        },
        "PROVIDER_NAME": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "CREDENTIAL_REVISION": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "IDENTITY_NAME": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "TLS_CA_PEM": {
          "type": "string",
          "minLength": 1
        },
        "MCP_URL": {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^https://"
        },
        "OAUTH_TOKEN_URL": {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^https://"
        },
        "OAUTH_CLIENT_ID": {
          "type": "string",
          "minLength": 1
        },
        "OAUTH_CLIENT_SECRET": {
          "type": "string",
          "minLength": 1
        },
        "OAUTH_RESOURCE": {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^https://"
        },
        "OAUTH_SCOPES": {
          "type": "string",
          "minLength": 1,
          "description": "Space-delimited OAuth action scopes; not a JSON array."
        }
      },
      "required": [
        "CONNECTION_SHAPE",
        "CONNECTION_MODE",
        "AUTH_TYPE",
        "CREDENTIAL_GRANULARITY",
        "PROVIDER_NAME",
        "CREDENTIAL_REVISION",
        "IDENTITY_NAME",
        "MCP_URL",
        "OAUTH_TOKEN_URL",
        "OAUTH_CLIENT_ID",
        "OAUTH_CLIENT_SECRET",
        "OAUTH_RESOURCE",
        "OAUTH_SCOPES"
      ],
      "description": "Decoded flat Secret.data keys for gateway mcp; never a JSON credential file."
    },

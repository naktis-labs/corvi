{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corvi.naktis.eu/schemas/generated-connection-secret/v1alpha1",
  "title": "Corvi generated app-credential Secret publication contract (proposed)",
  "description": "Design schema for MailCredential.spec fields and generated Secret connection.json. This is not a released CRD manifest or an implemented operator. A provider may issue direct app credentials only with supported scoped capabilities. See ADR-0014.",
  "oneOf": [
    {
      "$ref": "#/$defs/mailCredentialSpec"
    },
    {
      "$ref": "#/$defs/connectionDocument"
    }
  ],
  "$defs": {
    "secretTemplate": {
      "type": "object",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
            },
            "annotations": {
              "type": "object",
              "maxProperties": 40,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^(?!corvi\\.naktis\\.eu/)[A-Za-z0-9][A-Za-z0-9./_-]*$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 4096
              },
              "description": "User-owned annotation map; admission must also restrict unsafe replication/exfiltration controllers and service-account-token annotations."
            }
          },
          "additionalProperties": false,
          "description": "Only metadata.name and metadata.annotations are user customizable. Never data, namespace, ownerRefs or Secret type."
        }
      },
      "additionalProperties": false,
      "description": "Optional custom Secret metadata. If no name specified, the operator chooses a stable DNS-compliant derived name."
    },
    "mailCredentialSpec": {
      "type": "object",
      "properties": {
        "identityRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
              }
            },
            "additionalProperties": false,
            "required": [
              "name"
            ]
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mail:identities:list",
              "mail:messages:list",
              "mail:messages:search",
              "mail:messages:read",
              "mail:attachments:read",
              "mail:messages:send",
              "mail:submissions:read",
              "mail:messages:subscribe"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "connection": {
          "type": "object",
          "properties": {
            "strategy": {
              "type": "string",
              "const": "auto"
            }
          },
          "additionalProperties": false,
          "required": [
            "strategy"
          ],
          "description": "Auto resolves gateway if bound and active, otherwise provider direct only when safe. Unavailable bound gateway never falls back."
        },
        "secretTemplate": {
          "$ref": "#/$defs/secretTemplate"
        }
      },
      "additionalProperties": false,
      "required": [
        "identityRefs",
        "permissions",
        "connection"
      ],
      "description": "Proposed portable MailCredential spec fragment (not full structural Kubernetes CRD). Direct provider mode requires one identity/physical mailbox; gateway mode can support multi-identity scopes."
    },
    "reference": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "address": {
          "type": "string",
          "format": "email"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "address"
      ]
    },
    "tls": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "implicit",
            "starttls"
          ]
        },
        "serverName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9]$"
        },
        "caCertificateKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Optional key name in the same Secret for a trusted CA bundle; never an insecure_skip_verify toggle."
        }
      },
      "additionalProperties": false,
      "required": [
        "mode"
      ]
    },
    "socket": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9]$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "tls": {
          "$ref": "#/$defs/tls"
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "tls"
      ]
    },
    "http": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      },
      "additionalProperties": false,
      "required": [
        "url"
      ]
    },
    "gatewayOAuth": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "oauth2_client_credentials"
        },
        "issuer": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "tokenUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "clientSecret": {
          "type": "string",
          "minLength": 1,
          "description": "Sensitive generated value inside Secret data connection.json."
        },
        "resource": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mail:identities:list",
              "mail:messages:list",
              "mail:messages:search",
              "mail:messages:read",
              "mail:attachments:read",
              "mail:messages:send",
              "mail:submissions:read",
              "mail:messages:subscribe"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "tokenUrl",
        "clientId",
        "clientSecret",
        "resource",
        "scopes"
      ]
    },
    "smtpCredential": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "smtp_password",
          "description": "Separate Corvi SMTP username/password. SMTP OAuth Bearer requires a future explicit protocol profile; HTTP OAuth client_secret cannot be reused as SMTP password."
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "description": "Distinct SMTP AUTH password, not a Corvi HTTP OAuth client secret."
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "username",
        "password"
      ]
    },
    "gatewayServices": {
      "type": "object",
      "properties": {
        "rest": {
          "$ref": "#/$defs/http"
        },
        "mcp": {
          "$ref": "#/$defs/http"
        },
        "smtp": {
          "$ref": "#/$defs/socket"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "rest"
          ]
        },
        {
          "required": [
            "mcp"
          ]
        },
        {
          "required": [
            "smtp"
          ]
        }
      ]
    },
    "gatewayAuth": {
      "type": "object",
      "properties": {
        "oauth": {
          "$ref": "#/$defs/gatewayOAuth"
        },
        "smtp": {
          "$ref": "#/$defs/smtpCredential"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "oauth"
          ]
        },
        {
          "required": [
            "smtp"
          ]
        }
      ]
    },
    "providerPassword": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "app_password",
          "description": "An independently issued app-specific IMAP/SMTP credential, not the owner account password or a copied upstream OAuth access/refresh token."
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "secret": {
          "type": "string",
          "minLength": 1,
          "description": "Provider-issued app password/token accepted by this protocol and purpose; never the provider admin API key."
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "username",
        "secret"
      ]
    },
    "jmapCredential": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "api_token",
          "description": "Provider-issued JMAP API token scoped to the intended account; do not export the owner upstream OAuth token."
        },
        "token": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "token"
      ]
    },
    "providerServices": {
      "type": "object",
      "properties": {
        "imap": {
          "$ref": "#/$defs/socket"
        },
        "smtp": {
          "$ref": "#/$defs/socket"
        },
        "jmap": {
          "type": "object",
          "properties": {
            "sessionUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "accountId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "additionalProperties": false,
          "required": [
            "sessionUrl",
            "accountId"
          ]
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "imap"
          ]
        },
        {
          "required": [
            "smtp"
          ]
        },
        {
          "required": [
            "jmap"
          ]
        }
      ]
    },
    "providerAuth": {
      "type": "object",
      "properties": {
        "imap": {
          "$ref": "#/$defs/providerPassword"
        },
        "smtp": {
          "$ref": "#/$defs/providerPassword"
        },
        "jmap": {
          "$ref": "#/$defs/jmapCredential"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "imap"
          ]
        },
        {
          "required": [
            "smtp"
          ]
        },
        {
          "required": [
            "jmap"
          ]
        }
      ]
    },
    "gatewayConnection": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "corvi.naktis.eu/connection/v1"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "type": "string",
          "const": "gateway"
        },
        "services": {
          "$ref": "#/$defs/gatewayServices"
        },
        "auth": {
          "$ref": "#/$defs/gatewayAuth"
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gatewayIdentityGrant"
          },
          "minItems": 1,
          "maxItems": 64,
          "description": "Per-identity action grants scoped to the OAuth client and resource. Never flatten into union permission across identities."
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "revision",
        "services",
        "auth",
        "grants"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "services": {
                "anyOf": [
                  {
                    "required": [
                      "rest"
                    ]
                  },
                  {
                    "required": [
                      "mcp"
                    ]
                  }
                ]
              }
            },
            "required": [
              "services"
            ]
          },
          "then": {
            "properties": {
              "auth": {
                "required": [
                  "oauth"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "services": {
                "required": [
                  "smtp"
                ]
              }
            },
            "required": [
              "services"
            ]
          },
          "then": {
            "properties": {
              "auth": {
                "required": [
                  "smtp"
                ]
              }
            }
          }
        }
      ],
      "description": "Gateway mode: REST/MCP OAuth and optional separate SMTP credential, with per-identity grants. Authorization still requires current server-side policies."
    },
    "providerConnection": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "corvi.naktis.eu/connection/v1"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mail:identities:list",
              "mail:messages:list",
              "mail:messages:search",
              "mail:messages:read",
              "mail:attachments:read",
              "mail:messages:send",
              "mail:submissions:read",
              "mail:messages:subscribe"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "type": "string",
          "const": "providerDirect"
        },
        "services": {
          "$ref": "#/$defs/providerServices"
        },
        "auth": {
          "$ref": "#/$defs/providerAuth"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "identity",
        "capabilities",
        "revision",
        "services",
        "auth"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "services": {
                "required": [
                  "imap"
                ]
              }
            },
            "required": [
              "services"
            ]
          },
          "then": {
            "properties": {
              "auth": {
                "required": [
                  "imap"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "services": {
                "required": [
                  "smtp"
                ]
              }
            },
            "required": [
              "services"
            ]
          },
          "then": {
            "properties": {
              "auth": {
                "required": [
                  "smtp"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "services": {
                "required": [
                  "jmap"
                ]
              }
            },
            "required": [
              "services"
            ]
          },
          "then": {
            "properties": {
              "auth": {
                "required": [
                  "jmap"
                ]
              }
            }
          }
        }
      ],
      "description": "ProviderDirect mode: exactly one identity, and provider-issued credentials for only the explicitly listed supported services, with equivalent upstream isolation."
    },
    "connectionDocument": {
      "oneOf": [
        {
          "$ref": "#/$defs/gatewayConnection"
        },
        {
          "$ref": "#/$defs/providerConnection"
        }
      ]
    },
    "gatewayIdentityGrant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mail:identities:list",
              "mail:messages:list",
              "mail:messages:search",
              "mail:messages:read",
              "mail:attachments:read",
              "mail:messages:send",
              "mail:submissions:read",
              "mail:messages:subscribe"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "identity",
        "actions"
      ],
      "description": "The only authority-preserving way to advertise multiple identities; actions never union across grants."
    }
  },
  "x-corvi-contract": {
    "appliesTo": "MailCredential and supported provider-backed app-credential/token producer resources, via reusable secretTemplate and connection.json.",
    "outputSecretType": "Opaque",
    "mandatoryDataKey": "connection.json",
    "customMetadata": "secretTemplate.metadata.name and .annotations only; output namespace is fixed to resource namespace.",
    "resolution": "No MailProvider.gatewayRef -> safe providerDirect if provider can issue equivalent token. Bound ready gateway -> gateway. Bound unavailable or suspended gateway -> unavailable; no direct fallback.",
    "providerDirectRestriction": "Single identity/physical mailbox and provably equivalent policy boundary; no translation from scoped virtual identity to broad mailbox password.",
    "issuerSeparation": "Corvi OAuth client credentials and provider-issued app tokens remain distinct. Upstream OAuth refresh tokens are never published.",
    "unsupported": "No invented connection endpoints or auth modes; fail closed with status.",
    "lifecycle": "Versioned atomic Secret data updates, ownership check, no takeover, reissue on route change, safe rotation/revocation.",
    "authorization": "Secrets are sensitive. No plaintext in CRDs/status/labels/annotations or logs; Secret-write RBAC only for dedicated publisher or approved operator role.",
    "multipleIdentityGrants": "Gateway connection uses grants[] with separate identity+actions, never a global merged capabilities list. ProviderDirect uses one identity and scoped capabilities.",
    "tokenLifecycle": "v1alpha1 direct provider Secret supports independent app passwords/JMAP API tokens, not transient upstream OAuth access tokens. Future direct OAuth requires a complete independently issued per-app refresh/auth contract."
  }
}

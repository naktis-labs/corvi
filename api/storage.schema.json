{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corvi.naktis.eu/schemas/storage/v1alpha1",
  "title": "Corvi state and secret storage configuration (proposed)",
  "description": "Design contract for Corvi Kubernetes-native management storage (CRDs/status/Secrets/Leases), independent standalone/HA data-plane and OAuth issuer persistence, optional encrypted blobs (ADR-0010). Not implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "state",
    "secrets",
    "blobs",
    "features"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "corvi.naktis.eu/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "CorviStorage"
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "secrets": {
      "$ref": "#/$defs/secretStore"
    },
    "blobs": {
      "$ref": "#/$defs/blobStore"
    },
    "features": {
      "$ref": "#/$defs/features"
    },
    "controlPlane": {
      "$ref": "#/$defs/controlPlane",
      "description": "Optional management-only storage configuration, wholly separate from data-plane/OAuth SQL state."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "features": {
            "properties": {
              "integratedOAuthIssuer": {
                "const": true
              }
            },
            "required": [
              "integratedOAuthIssuer"
            ]
          }
        },
        "required": [
          "features"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "properties": {
              "backend": {
                "enum": [
                  "sqlite",
                  "postgres"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "features": {
            "properties": {
              "durableSubmission": {
                "const": true
              }
            },
            "required": [
              "durableSubmission"
            ]
          }
        },
        "required": [
          "features"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "properties": {
              "backend": {
                "enum": [
                  "sqlite",
                  "postgres"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "features": {
            "properties": {
              "durableTasks": {
                "const": true
              }
            },
            "required": [
              "durableTasks"
            ]
          }
        },
        "required": [
          "features"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "properties": {
              "backend": {
                "enum": [
                  "sqlite",
                  "postgres"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "features": {
            "properties": {
              "persistentMailboxSync": {
                "const": true
              }
            },
            "required": [
              "persistentMailboxSync"
            ]
          }
        },
        "required": [
          "features"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "properties": {
              "backend": {
                "enum": [
                  "sqlite",
                  "postgres"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "features": {
            "properties": {
              "multiReplica": {
                "const": true
              }
            },
            "required": [
              "multiReplica"
            ]
          }
        },
        "required": [
          "features"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "properties": {
              "backend": {
                "const": "postgres"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "state": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "ephemeral",
            "sqlite",
            "postgres"
          ]
        },
        "sqlite": {
          "$ref": "#/$defs/sqlite"
        },
        "postgres": {
          "$ref": "#/$defs/postgres"
        }
      },
      "additionalProperties": false,
      "required": [
        "backend"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "const": "sqlite"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "required": [
              "sqlite"
            ],
            "not": {
              "required": [
                "postgres"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "postgres"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "required": [
              "postgres"
            ],
            "not": {
              "required": [
                "sqlite"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "ephemeral"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sqlite"
                  ]
                },
                {
                  "required": [
                    "postgres"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "sqlite": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "wal": {
          "type": "boolean",
          "const": true
        },
        "busyTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "description": "Standalone/local-filesystem-only; must reject multiple active replicas on one database path."
    },
    "postgres": {
      "type": "object",
      "properties": {
        "dsnRef": {
          "type": "string",
          "pattern": "^secret://[^\\s]+$",
          "minLength": 10,
          "maxLength": 1024,
          "description": "Abstract trusted secret resolver reference; never a raw credential value."
        },
        "tlsMode": {
          "type": "string",
          "enum": [
            "verify-full"
          ]
        },
        "poolSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "dsnRef",
        "tlsMode"
      ]
    },
    "secretStore": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "encryptedFile",
            "external",
            "kubernetesSecret"
          ]
        },
        "encryptedFile": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "wrappingKeyRef": {
              "type": "string",
              "pattern": "^secret://[^\\s]+$",
              "minLength": 10,
              "maxLength": 1024,
              "description": "Abstract trusted secret resolver reference; never a raw credential value."
            }
          },
          "additionalProperties": false,
          "required": [
            "path",
            "wrappingKeyRef"
          ]
        },
        "external": {
          "type": "object",
          "properties": {
            "driver": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "endpointRef": {
              "type": "string",
              "pattern": "^secret://[^\\s]+$",
              "minLength": 10,
              "maxLength": 1024,
              "description": "Abstract trusted secret resolver reference; never a raw credential value."
            },
            "credentialsRef": {
              "type": "string",
              "pattern": "^secret://[^\\s]+$",
              "minLength": 10,
              "maxLength": 1024,
              "description": "Abstract trusted secret resolver reference; never a raw credential value."
            }
          },
          "additionalProperties": false,
          "required": [
            "driver",
            "endpointRef"
          ]
        },
        "kubernetesSecret": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "mountPath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "additionalProperties": false,
          "required": [
            "namespace",
            "mountPath"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "backend"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "const": "encryptedFile"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "required": [
              "encryptedFile"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "external"
                  ]
                },
                {
                  "required": [
                    "kubernetesSecret"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "external"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "required": [
              "external"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "encryptedFile"
                  ]
                },
                {
                  "required": [
                    "kubernetesSecret"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "kubernetesSecret"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "required": [
              "kubernetesSecret"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "encryptedFile"
                  ]
                },
                {
                  "required": [
                    "external"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "blobStore": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "disabled",
            "encryptedDirectory",
            "s3"
          ]
        },
        "encryptedDirectory": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "wrappingKeyRef": {
              "type": "string",
              "pattern": "^secret://[^\\s]+$",
              "minLength": 10,
              "maxLength": 1024,
              "description": "Abstract trusted secret resolver reference; never a raw credential value."
            }
          },
          "additionalProperties": false,
          "required": [
            "path",
            "wrappingKeyRef"
          ]
        },
        "s3": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "bucket": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "credentialsRef": {
              "type": "string",
              "pattern": "^secret://[^\\s]+$",
              "minLength": 10,
              "maxLength": 1024,
              "description": "Abstract trusted secret resolver reference; never a raw credential value."
            },
            "encryptionKeyRef": {
              "type": "string",
              "pattern": "^secret://[^\\s]+$",
              "minLength": 10,
              "maxLength": 1024,
              "description": "Abstract trusted secret resolver reference; never a raw credential value."
            },
            "prefix": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "additionalProperties": false,
          "required": [
            "endpoint",
            "bucket",
            "credentialsRef",
            "encryptionKeyRef"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "backend"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "const": "encryptedDirectory"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "required": [
              "encryptedDirectory"
            ],
            "not": {
              "required": [
                "s3"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "s3"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "required": [
              "s3"
            ],
            "not": {
              "required": [
                "encryptedDirectory"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "disabled"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "encryptedDirectory"
                  ]
                },
                {
                  "required": [
                    "s3"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "features": {
      "type": "object",
      "properties": {
        "integratedOAuthIssuer": {
          "type": "boolean",
          "default": false
        },
        "durableSubmission": {
          "type": "boolean",
          "default": false
        },
        "durableTasks": {
          "type": "boolean",
          "default": false
        },
        "persistentMailboxSync": {
          "type": "boolean",
          "default": false
        },
        "persistInboundMail": {
          "type": "boolean",
          "const": false,
          "description": "Raw inbound-mail persistence is not configured in the baseline schema; future explicit opt-in design needs separate encryption/retention contract."
        },
        "multiReplica": {
          "type": "boolean",
          "default": false
        },
        "searchIndex": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "integratedOAuthIssuer",
        "durableSubmission",
        "durableTasks",
        "persistentMailboxSync",
        "multiReplica",
        "persistInboundMail"
      ]
    },
    "controlPlane": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "kubernetes",
            "standaloneFile",
            "disabled"
          ],
          "description": "Kubernetes mode does not require an operator SQL database."
        },
        "kubernetes": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "description": "Namespace containing the Corvi management custom resources and approved secrets."
            },
            "leaderElectionLeaseName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "description": "Optional Kubernetes Lease name for operator leader election."
            }
          },
          "additionalProperties": false,
          "required": [
            "namespace"
          ],
          "description": "Kubernetes CRD spec/status, Secret references and Lease objects are authoritative. Do not create a SQL shadow database for management."
        },
        "standaloneFile": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "description": "Standalone management desired-state file; no Kubernetes API required."
        }
      },
      "additionalProperties": false,
      "required": [
        "backend"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "const": "kubernetes"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "required": [
              "kubernetes"
            ],
            "not": {
              "required": [
                "standaloneFile"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "standaloneFile"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "required": [
              "standaloneFile"
            ],
            "not": {
              "required": [
                "kubernetes"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "disabled"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "kubernetes"
                  ]
                },
                {
                  "required": [
                    "standaloneFile"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "x-corvi-design-notes": {
    "authoritativeMailbox": "IMAP/JMAP provider remains source-of-truth for inbound mail.",
    "secrets": "Provider OAuth refresh tokens and Corvi signing keys are not stored plaintext in SQL or config.",
    "localOnlySQLite": true,
    "defaults": "No raw inbound mail cache and no external DB mandatory for an ephemeral direct gateway.",
    "authorization": "All caches/indexes/blobs require policy-scoped per-client/per-identity checks.",
    "references": [
      "docs/adr/0010-storage-and-durability.md",
      "docs/adr/0009-corvi-oauth-and-identity-grants.md"
    ],
    "controlPlane": "In Kubernetes mode CRD spec/status, approved Secret references and Leases are the sole authoritative control-plane store; operator-only installs require neither SQLite nor PostgreSQL. Do not create shadow management SQL tables.",
    "stateScope": "state.backend chooses data-plane and OAuth issuer transactional persistence only; never replaces Kubernetes operator reconciliation storage.",
    "kubernetesSecrets": "Kubernetes Secret storage requires RBAC and configured at-rest encryption; not every operator has permission to read token or signing secrets."
  }
}
